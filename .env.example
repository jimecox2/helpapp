# helpapp (Timebars Cloud). Copy to .env.local, chmod 600, never commit.
#   Server:      not used. tbown's apply writes $TB/tbhelp/.env.local and 03-make-passwords.sh writes the keys
#                to $TB/tbhelp/.secrets.env (from $TB/secrets.env).
#   Workstation: .env.local in this repo, for npm run dev (port 3009; NEXTAUTH_URL=http://localhost:3009).
# Every value here is read by the server only. Never give a secret a NEXT_PUBLIC_ name.

# --- Google Gemini (Ask AI, AI Create, business case, help assistant, TB Generator) ---
# Your own key from aistudio.google.com, restricted to the Generative Language API.
GEMINI_API_KEY=CHANGE_ME

# --- Login check for /api/ai/* ---
# The app sends the user's Timebars Cloud login with each AI request and this server checks it
# against Strapi. Use the same address as the app's apiUrl (runtime-config.json), with /api.
STRAPI_URL=https://be2.example.com/api
# Set to false only for sites with no Strapi (air-gapped LAN, licence by file).
# AI_REQUIRE_LOGIN=false


# --- Strapi server token (server only; never NEXT_PUBLIC_) ---
# Used for dashboard-source share/delete/create, Users & Roles, and confirming OAuth sign-ups.
# Was NEXT_PUBLIC_FULL_ACCESS_ADMIN_TOKEN in tbwww, which put it in the browser. Rotate it in Strapi.
STRAPI_ADMIN_TOKEN=CHANGE_ME

# --- Limits (optional; defaults shown) ---
# AI_RATE_LIMIT_PER_MIN=30        # requests per client IP per minute
# AI_MAX_BODY_BYTES=10485760      # largest request body accepted (10 MB)

# --- CORS (optional) ---
# Not needed when the app's nginx proxies /ai/ to this container (same origin). Only if a browser
# calls this service directly, list the app addresses, comma separated. Never use *.
# AI_ALLOWED_ORIGINS=https://tb.example.com,https://ppm.example.com

# --- Login (NextAuth, same Strapi as www.timebars.com; this app keeps its own session) ---
# Both are required: without them Sign In goes to https://0.0.0.0:3010/auth/error?error=Configuration.
# A long random string: openssl rand -base64 32. Not shared with www.
NEXTAUTH_SECRET=CHANGE_ME
# The address users open on THIS box: https://cloud.timebars.com (tbdovm), https://cloud.rlan.ca (gmk1),
# http://localhost:3009 in dev. The container cannot work it out itself behind the tunnel.
NEXTAUTH_URL=https://cloud.timebars.com

# --- Public addresses for THIS box (read at run time, no rebuild) ---
# Unset = Timebars Ltd. production (be2 / www / ab / tb / cb .timebars.com). Set them on any other
# box, e.g. gmk1:
#   CLOUD_API_URL=https://be2.rlan.ca/api
#   CLOUD_WWW_URL=https://www.rlan.ca
#   CLOUD_HELP_URL=https://help.rlan.ca
#   RUN_URL_AB=https://agile.rlan.ca
#   RUN_URL_TB=https://pmrm.rlan.ca
#   RUN_URL_CB=https://ppm.rlan.ca
# The Cloud address itself comes from NEXTAUTH_URL (CLOUD_FRONTEND_URL only if it must differ).
# CLOUD_API_URL_GQL (Strapi address for uploaded images) defaults to CLOUD_API_URL without /api.
CLOUD_API_URL=
CLOUD_WWW_URL=
# Public help address (default https://help.timebars.com; staging https://helps.timebars.com). Written into
# the links of help-articles that /update-help pushes to Strapi.
CLOUD_HELP_URL=
RUN_URL_AB=
RUN_URL_TB=
RUN_URL_CB=
# Environment name (tbapps.conf section, written by tbown's apply): DEV, STAGING, PROD or TRAINING.
# Anything but PROD shows a dark red nav bar with the name, so staging is not mistaken for production.
# Unset = PROD. On the workstation use DEV.
TB_ENVIRONMENT=DEV




# --- Who may push help content to Strapi (/update-help) ---
# Comma-separated emails. The user must also have primary_role Administrator in Strapi. Empty = nobody.
HELP_EDITORS=jcox@tbcox.com,jimecox@live.ca
