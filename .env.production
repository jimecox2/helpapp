# Public addresses baked into the browser code at build time (npm run build / docker build).
# Public values only: NEXT_PUBLIC_ names are visible to everyone. Secrets go in .env.local.
# A server can override them at run time without a rebuild: CLOUD_API_URL, CLOUD_WWW_URL,
# CLOUD_FRONTEND_URL (or NEXTAUTH_URL) in its .env.local — see .env.example and config/site.js.
NEXT_PUBLIC_API_URL=https://be2.timebars.com/api
NEXT_PUBLIC_API_URL_GQL=https://be2.timebars.com
NEXT_PUBLIC_FRONTEND_URL=https://cloud.timebars.com
NEXT_PUBLIC_WWW_URL=https://www.timebars.com
